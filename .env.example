# ==========================================
# BRICK62 - Environment Variables Configuration
# ==========================================

# --- Database ---
# MongoDB Atlas connection string. If omitted in local dev, backend uses high-fidelity in-memory storage.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/brick62?retryWrites=true&w=majority&appName=Brick62

# --- Dodo Payments (Merchant of Record) ---
# API Key from Dodo Payments dashboard (test or live mode)
DODO_PAYMENTS_API_KEY=test_dodo_apikey_placeholder
# Webhook secret from Dodo Payments dashboard webhooks section
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_placeholder
# Mode: "test" or "live"
DODO_ENV=test
# Base URL of your deployed application (for webhook registration and return URLs)
NEXT_PUBLIC_APP_URL=https://brick62.vercel.app

# --- Security & Auth ---
# Secret key used for signing guest / auth tokens (at least 32 characters)
SESSION_SECRET=super_secret_session_key_change_in_production_min32chars
# Secret required to trigger Vercel Cron jobs manually or via Vercel scheduler
CRON_SECRET=cron_secret_auth_token_for_scheduled_tasks

# --- Admin Dashboard ---
# Password to access the protected admin review dashboard (/admin)
ADMIN_PASSWORD=change_this_admin_password_in_production

# --- Feature Flags ---
# Enable prize tournaments / sweepstakes in permitted jurisdictions (0 = disabled, 1 = enabled)
ENABLE_PRIZES=0
# Comma-separated ISO country codes where prize features are legally cleared to operate
ALLOWED_PRIZE_REGIONS=US,CA,GB
